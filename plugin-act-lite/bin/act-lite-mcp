#!/bin/sh
# Start act-lite for the plugin's MCP server, with no separate install.
#
# Runs act-lite from PATH when its version equals the plugin version. Otherwise
# it downloads that release for this platform once, checks its SHA-256, keeps
# the binary in the plugin data directory, and runs it from there.
#
# stdout is the MCP channel: every message from this script goes to stderr.
#
# Environment:
#   CLAUDE_PLUGIN_DATA    directory for the kept binary (default: <plugin>/.data)
#
# Test seams (not for normal use), as in install.sh:
#   ACT_LITE_BASE_URL     base of the download URLs (<base>/<tag>/<file>)
#   ACT_LITE_UNAME_S      replaces the output of `uname -s`
#   ACT_LITE_UNAME_M      replaces the output of `uname -m`

set -eu

die() {
  printf 'act-lite plugin: %s\n' "$*" >&2
  exit 1
}

root=$(cd "$(dirname "$0")/.." && pwd)
manifest=$root/.claude-plugin/plugin.json
version=$(sed -n 's/^[[:space:]]*"version"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "$manifest" | head -n 1)
[ -n "$version" ] || die "no version in $manifest"
tag=v$version

if command -v act-lite >/dev/null 2>&1 &&
  [ "$(act-lite --version 2>/dev/null)" = "act-lite $version" ]; then
  exec act-lite "$@"
fi

data=${CLAUDE_PLUGIN_DATA:-$root/.data}
bin=$data/$tag/act-lite

# A start stopped during its download leaves a .download.* directory. One older
# than 10 minutes is not in use: Claude Code stops a server that does not start
# within 30 seconds.
if [ -d "$data" ]; then
  find "$data" -maxdepth 1 -name '.download.*' -mmin +10 -exec rm -rf {} + 2>/dev/null || true
fi

if [ ! -x "$bin" ]; then
  os=${ACT_LITE_UNAME_S:-$(uname -s)}
  arch=${ACT_LITE_UNAME_M:-$(uname -m)}
  case "$os/$arch" in
    Linux/x86_64) target=x86_64-unknown-linux-gnu ;;
    Linux/aarch64 | Linux/arm64) target=aarch64-unknown-linux-gnu ;;
    Darwin/x86_64) target=x86_64-apple-darwin ;;
    Darwin/arm64 | Darwin/aarch64) target=aarch64-apple-darwin ;;
    *) die "unsupported platform: $os $arch (supported: Linux and macOS on x86_64 and arm64)" ;;
  esac
  command -v curl >/dev/null 2>&1 || die "curl is required to download act-lite $tag"

  base=${ACT_LITE_BASE_URL:-https://github.com/act101-ai/act-lite/releases/download}
  name=act-lite-$tag-$target
  mkdir -p "$data/$tag" || die "could not create $data/$tag"
  tmp=$(mktemp -d "$data/.download.XXXXXX") || die "could not create a temporary directory in $data"
  trap 'rm -rf "$tmp"' EXIT
  trap 'exit 1' HUP INT TERM

  printf 'act-lite plugin: downloading act-lite %s for %s\n' "$tag" "$target" >&2
  for file in "$name.tar.gz" "$name.tar.gz.sha256"; do
    curl -fsSL -o "$tmp/$file" "$base/$tag/$file" || die "download failed: $base/$tag/$file"
  done

  read -r expected listed <"$tmp/$name.tar.gz.sha256" || true
  if command -v shasum >/dev/null 2>&1; then
    actual=$(shasum -a 256 "$tmp/$name.tar.gz")
  elif command -v sha256sum >/dev/null 2>&1; then
    actual=$(sha256sum "$tmp/$name.tar.gz")
  else
    die "shasum or sha256sum is required but was not found"
  fi
  if [ "${listed:-}" != "$name.tar.gz" ] || [ "${actual%% *}" != "${expected:-}" ]; then
    die "checksum mismatch for $name.tar.gz; nothing was installed"
  fi

  tar -xzf "$tmp/$name.tar.gz" -C "$tmp" || die "could not extract $name.tar.gz"
  [ -f "$tmp/$name/act-lite" ] || die "$name.tar.gz does not contain $name/act-lite"
  chmod 0755 "$tmp/$name/act-lite"
  "$tmp/$name/act-lite" --version >/dev/null 2>&1 ||
    die "the downloaded act-lite does not run on this system (Linux needs glibc 2.31 or later)"
  mv -f "$tmp/$name/act-lite" "$bin" || die "could not write $bin"
  # exec below skips the EXIT trap, so remove the download directory here
  rm -rf "$tmp"
  trap - EXIT

  for old in "$data"/v*; do
    [ "$old" = "$data/$tag" ] || rm -rf "$old"
  done
fi

exec "$bin" "$@"
